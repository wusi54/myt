# ============ 投屏 MediaMTX 相关（关键） ============
# agent 推流目标（relay 容器用）。本地联调填 192.168.10.43:8554；生产填 113.105.100.58:8554
MEDIAMTX_RTSP_URL=rtsp://113.105.100.58:8554
# 浏览器 WHEP 直连地址（仅用于信息展示，实际拉流走 nginx /mtx 反代）
MEDIAMTX_WEBRTC_URL=http://113.105.100.58:8889
# nginx 反代 /mtx(WHEP) 实际转发的 MediaMTX 地址【必须与上面推流地址同一实例】
# 本地联调填 192.168.10.43:8889；生产填 113.105.100.58:8889
MTX_WEBRTC_UP=113.105.100.58:8889

# agent 推流传输协议：tcp(默认, NAT 穿透稳定) / udp(仅同网段低延迟排障)
AGENT_TRANSPORT=tcp

# ============ 投屏画质（可选） ============
AGENT_MAX_SIZE=720
AGENT_BITRATE=1000000
AGENT_KEYFRAME_INTERVAL=0
AGENT_IDLE_STOP_SEC=0

# ============ 通用（按需） ============
SECRET_KEY=change-me-in-production
